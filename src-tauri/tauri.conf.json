{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProcessDevKill",
  "version": "1.0.0",
  "identifier": "com.processdevkill.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProcessDevKill",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGRjZGRUUwRTU4QjZCMzYKUldRMmE0dmw0UDcyejJWd1FxT0JCeURzcVgwQ1lsdVF2NTRHaHVRZWZnYk0vcHhJazRleVFRUE4K",
      "endpoints": [
        "https://github.com/xfiberex/ProcessDevKill/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ricky Angel Jiménez Bueno",
    "copyright": "© 2026 Ricky Angel Jiménez Bueno",
    "category": "DeveloperTool",
    "shortDescription": "Gestor de procesos de desarrollo",
    "longDescription": "Lista los procesos de desarrollo activos (node, python, dotnet…) con su consumo de CPU y RAM y el puerto local que ocupa cada uno, y permite cerrarlos de uno en uno o en lote.",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
