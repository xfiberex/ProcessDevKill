{
  "compilerOptions": {
    "composite": true,
    // `composite` obliga a emitir, y no se puede desactivar con `noEmit`: un proyecto referenciado
    // que no emite es error TS6310. Sin redirigirlo, `tsc -b` deja un .js y un .d.ts al lado de
    // cada config, en la raiz del repositorio — ruido que ademas ABORTA release.ps1, que exige el
    // arbol limpio antes de cortar. Aqui solo interesa comprobar tipos, asi que lo emitido va a
    // node_modules, que ya esta ignorado.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  // vitest.config.ts entra aqui: sin el, ningun tsconfig lo miraba -el principal solo incluye
  // `src`- y un error de tipos en la configuracion de las pruebas no lo habria visto nadie.
  "include": ["vite.config.ts", "vitest.config.ts"]
}
